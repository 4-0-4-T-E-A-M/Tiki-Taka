# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 사용하세요.
# .env는 gitignore 처리되어 커밋되지 않습니다.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/tikitaka
DB_USERNAME=
DB_PASSWORD=

# JWT (Base64로 인코딩된 최소 256비트 비밀키)
# 생성 예시: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=
JWT_REFRESH_TOKEN_EXPIRY=

# Google OAuth2 (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=